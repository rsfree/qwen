# qwen-service 配置模板 —— 复制为 .env 并填值（.env 已被 gitignore，凭据不落库）
#
# 口径：**本文件是字段说明的权威来源**；`# KEY=值` 是「注释态登记」= 用代码默认。
# 与代码默认不一致的地方，注释里会写明「代码默认 X」，别按字面想当然。
# 键集合由 `.env` 侧的门禁核对（`tests/test_env_contract.py`）：**新增参数先加这里，再同步到 .env**。

# ---------- 上游 ----------
QWEN_BASE_URL=https://chat.qwen.ai
# 会话用的聊天模型（不是"视频模型"——上游没有视频模型这一层，见 docs/UPSTREAM.md §8）。
# 代码默认 `qwen3.7-plus`（未在本仓实测）；**本仓实测出片用的是 `qwen3.8-max`**（UPSTREAM §7.1）。
QWEN_CHAT_MODEL=qwen3.8-max
# 空 = 用内置 Chrome UA。🔴 与 UPSTREAM §2.2 的头指纹同源，别随手改（改错会吃 WAF/RGV587）。
# QWEN_USER_AGENT=
# 🔴 `0.2.0` 是**写端点硬门槛**：缺它必被判 `Bad_Request`（文案极具误导性，见 UPSTREAM §2.3）。
# QWEN_VERSION_HEADER=0.2.0
# 单请求超时（秒）。⚠️ 不是"等出片"的超时 —— 提交/查询都是秒级；出片等待由 TASK_TIMEOUT 管。
# QWEN_UPSTREAM_TIMEOUT=60
# 🔴 **别开**：置 1 会让使用侧也去读宿主的 HTTP(S)_PROXY/ALL_PROXY ⇒ 出口变成"经代理、可能一请求一 IP"，
#    且是**静默**行为改变（UPSTREAM §2.5）。使用侧的正确姿势是**直连单出口**。
# QWEN_TRUST_ENV=0
# 查询接口推进任务的节奏（秒）。协调器另有自己的 tick（见下）。
# POLL_INTERVAL=3

# ---------- 账号池 ----------
# 逗号分隔的 `email:password` 列表；密码相同可只留邮箱、统一写 QWEN_ACCOUNT_PASSWORD。
QWEN_ACCOUNTS=
QWEN_ACCOUNT_PASSWORD=
# 或每行一条（# 注释；密码含逗号时必须用文件形态）：
# QWEN_ACCOUNTS_FILE=/app/var/accounts.txt
# 视频额度 3 次/天/账号（**UTC 日**窗口，t2v+i2v 共用）⇒ 真实天花板 = 账号数 × 3。
QWEN_DAILY_VIDEO_CAP=3
# 取号等待上限（秒）。等不到 ⇒ 落 `queued` 排队（默认开队列；见下面「排队 / 重试」段）。
# QWEN_ACCOUNT_WAIT_TIMEOUT=30
# 同账号两次提交的最小间隔（秒），防写请求突发。
# QWEN_SUBMIT_MIN_INTERVAL=15
# 可选：每账号附加 cookie 串（整份浏览器 jar，或 ssxmod_itna/acw_tc 等指纹 cookie）。
# 默认空 = 只发 `Cookie: token=<JWT>`（登录态最小凭据，实测可用，见 UPSTREAM §2.1）。
# QWEN_ACCOUNT_COOKIES={"a@x.cn": "整份浏览器 jar，或反爬指纹 cookie（键名见 reverse-proxy 文档）"}
# QWEN_ACCOUNT_COOKIES_FILE=/app/var/account_cookies.json

# ---------- token 铸造（2026-09-30 起认证在独立 auth 域；续期主路 = refresh，signin 兜底） ----------
# 🔴 **只收 `http(s)://` 代理**（SOCKS 分支已按决策删除，喂 `socks5h://` 会直接报错）。
# 实测池语义：**每连接换 IP + 同连接复用同 IP** ⇒ 每次铸造换一个 IP、一次铸造全程一个 IP（UPSTREAM §2.5）。
# 真实地址与凭据写进 .env（已 gitignored，600）；模板只放占位符。
# 🔴 2026-09-30 改版：旧 chat 域 signin 对纯 HTTP 客户端回**滑块挑战页**（无解）——
#    signin 已迁 **auth.qwen.ai**（body 回 15min access_token + 30d refresh_token cookie），
#    正常续期走 refresh（免密码免预热不拦滑块），signin 只在 RT 失效时发生（≈30 天一次）。
#    signin 仍有 **IP 级频率墙**（≈12 次/6 分钟）⇒ 轮换出口 + 45s 跨账号节流照旧。
QWEN_SIGNIN_PROXY=http://POOL_USER:POOL_PASS@pool.example:2086
# 或改用外部 token 服务（`GET /token?account=`，image-adapter tools/token_service.py 同款接口）：
# QWEN_TOKEN_URL=http://token-service.example:8792/token
# 认证域基址（**含 `/api` 前缀**）。默认即 auth.qwen.ai；厂商换域时用这个键接管，不发版。
# QWEN_AUTH_BASE=https://auth.qwen.ai/api
# token 缓存**上限**（秒）。主动续期 = min(JWT 的 exp − 提前量, 铸后本值)：
#   🔴 2026-09-30 起 access token 只有 **15 分钟**（exp 提前量 90s 生效），本上限只压
#   "自称长寿"的旧形状/外部 token；`<=0` 也归一到 6 天（刻意**没有**"关掉上限"的开关）。
#   真正兜底的是被动路径：判 401 ⇒ 立即重铸（先 refresh）+ 原请求重试一次。
# QWEN_TOKEN_TTL=518400
# 跨账号共享的 signin 节奏（秒）—— 防"几秒内连登多个账号"把出口打进 WAF 墙。
# （只拦 signin 这条腿；refresh 无墙，不被它连坐。）
# QWEN_SIGNIN_MIN_INTERVAL=45
# signin 节流等待上限（秒）。超过就报 503 让调用方稍后重试，而不是死等。
# QWEN_SIGNIN_WAIT_TIMEOUT=45

# ---------- 排队 / 重试（复用任务表，无独立队列组件；见 docs/INTERFACE.md §3.3） ----------
# 容量不足（账号全忙/冷却/额度尽）⇒ 落 `queued` 并立即返回 id，由协调器或后续 GET 出队提交。
# 只重试「可证明上游未受理」的失败；含义不明的失败（5xx/超时）**绝不**自动重试（防重复计费）。
# `0` = 严格模式：容量不足直接回 429（回到加队列之前的行为）。
# SUBMIT_QUEUE_ENABLED=1
# 排队深度上限：超限回 429 + Retry-After（背压保留，绝不无限囤积）。
# QUEUE_MAX_DEPTH=50
# 单任务最大提交尝试次数；超限落 failed 且**明示"未提交、未消耗额度"**。
# SUBMIT_MAX_ATTEMPTS=5
# 排队重试退避基数（秒）；指数退避 base×2^n，上限 600s。
# QUEUE_RETRY_BASE=30

# ---------- 对外鉴权（留空 = 关闭鉴权，仅限内网） ----------
API_KEYS=
# HMAC 指纹密钥（任务记录只存 Key 指纹，永不落明文）。空 = 在 DATA_DIR 落一个 600 的随机值（重启不变）。
# KEY_SECRET=

# ---------- OpenAI chat 门（/v1/chat/completions + /v1/models 注册） ----------
# 上游模型清单（GET /api/models，免鉴权）的缓存时长（秒）：到期才拉一次；
# 拉取失败回退上一份好清单（负缓存顺延本值，绝不因上游抖动让 /v1/models 5xx）。
# MODELS_CACHE_TTL=300

# 思考摘要会漏进正文的模型名单（裸名，逗号分隔）：命中且调用方**未显式**声明思考档位时，
# chat 门自动切快速档（2026-10-02 实测 qwen3.8-omni-flash：auto/thinking 档把思考过程写进
# 正文 content，无 reasoning_content 字段）。不设 = 走上行默认名单（加固默认生效）；
# 显式设为空 = 关闭加固（上游修好后的回退开关）。
# QWEN_THINKING_LEAK_MODELS=qwen3.8-omni-flash

# ---------- 能力回退通道（chat/responses 门；qwen 不支持的能力 → 方舟 chat 应答，INTERFACE §8.8） ----------
# 触发：请求带 tools/tool_choice（函数调用）、文件/音频/视频分段、多图或 data: URI 图片、
# Responses 的工具调用状态输入项。KEY + MODEL **同时**配置才启用（只配一个拒绝启动）；
# 留空 = 关闭回退（回到降级/400 行为）。KEY 是凭据，只写 .env。
ARK_FALLBACK_KEY=
ARK_FALLBACK_MODEL=
# **备用回退模型链**（逗号分隔，按序 failover）：主模型被方舟限流（429）时依次切换重试；
# 全部被限 ⇒ 429 原样转发。可选；所有模型名都在出站报文脱敏之列。
# ARK_FALLBACK_MODELS=model-b,model-c
# 方舟 chat 端点（默认北京 region；其他 region 换域名即可）。
# ARK_FALLBACK_BASE=https://ark.cn-beijing.volces.com/api/v3
# 回退请求超时（秒）。chat 生成可能较长，别设太小。
# ARK_FALLBACK_TIMEOUT=120

# ---------- 附件上传链（chat 门；文件/音频/视频/data: 图 → getstsToken → OSS PUT，UPSTREAM §4.7） ----------
# 启用后：file/input_file、audio_url/input_audio、video_url、data: 图片分段 ⇒
# 服务端代下载/解码 → 上传上游 OSS → files[] 条目 → qwen 原生解析。
# 关闭（=0）时：这些分段转回退通道（如已配置），否则 400。默认开。
# QWEN_UPLOAD_ENABLED=1
# 附件大小上限（字节，服务端代下载与上传共用）。默认 20MB。
# QWEN_UPLOAD_MAX_BYTES=20000000

# ---------- 任务持久化 ----------
# 空 = `sqlite:///<DATA_DIR>/qwen.db`（单机够用）；多实例共享请换 PostgreSQL：
# TASK_DB=postgresql+psycopg2://qwen:qwen@db:5432/qwen
# 数据目录：SQLite 任务库、hmac 密钥、产物落盘都在这里。容器里是 /app/var（compose 挂卷保留）。
# 代码默认 `<仓库>/var`。
DATA_DIR=/app/var
# 未终态任务的超时阈值（秒）→ `expired`；**排队中的任务同样受此闸门**（超时落 failed 并明示未消耗额度）。
# TASK_TIMEOUT=900
# 记录保留期（天）：契约要求 `GET /tasks/{id}` 在 7 天窗口内可用。
TASK_RETENTION_DAYS=7
# 后台协调器：出队 queued 任务 + 主动回查 + 过期清理。**默认开**（它是队列的唯一消费者）。
# COORDINATOR_ENABLED=1
# 协调器轮询间隔（秒）。
# COORDINATOR_TICK=5

# ---------- 进程 ----------
HOST=0.0.0.0
PORT=8400
LOG_LEVEL=INFO
# 以下两项由 `gunicorn_conf.py` 读（不是本应用的配置项）。
# 🔴 `WORKERS=1` 是**架构约束**不是保守参数：账号节奏（提交间隔 / signin 节流 / 额度计数）是进程内状态。
# WORKERS=1
# gunicorn 单请求超时（秒）。提交与查询都是秒级；别设太小。
# GUNICORN_TIMEOUT=120
